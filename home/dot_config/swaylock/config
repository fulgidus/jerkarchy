# swaylock — ring always visible so a locked screen never looks like a dead
# one. The background image is passed by session-lock (the live wallpaper's
# current frame, per output); color= is the fallback.
scaling=fill
color=0a0a0f
indicator-idle-visible
indicator-radius=90
indicator-thickness=8
show-failed-attempts
ignore-empty-password
font=JetBrainsMono Nerd Font

inside-color=0a0a0fcc
ring-color=00f0ffff
line-color=00000000
separator-color=00000000
text-color=c8c8d0ff
key-hl-color=ff2b6dff
bs-hl-color=ffcc00ff

inside-ver-color=0a0a0fcc
ring-ver-color=00ff9fff
text-ver-color=00ff9fff

inside-wrong-color=0a0a0fcc
ring-wrong-color=ff2b6dff
text-wrong-color=ff2b6dff

inside-clear-color=0a0a0fcc
ring-clear-color=ffcc00ff
text-clear-color=ffcc00ff

layout-bg-color=0a0a0fcc
layout-text-color=c8c8d0ff
