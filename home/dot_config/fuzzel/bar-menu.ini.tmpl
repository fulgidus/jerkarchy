{{- $t := index .themes .theme -}}
# fuzzel style for drop-down menus opened from waybar (wifi-menu, …).
# Same palette/font/square borders as waybar, anchored under the bar's right end.
[main]
font=JetBrainsMono Nerd Font:size=10
dpi-aware=no
anchor=top-right
x-margin=6
y-margin=4
layer=overlay
lines=12
minimal-lines=yes
width=44
horizontal-pad=12
vertical-pad=8
inner-pad=6
prompt="› "
exit-on-keyboard-focus-loss=yes

[colors]
background={{ $t.bg | trimPrefix "#" }}ff
text={{ $t.fg | trimPrefix "#" }}ff
prompt={{ $t.accent | trimPrefix "#" }}ff
placeholder={{ $t.fg_mute | trimPrefix "#" }}ff
input={{ $t.fg_bright | trimPrefix "#" }}ff
match={{ $t.accent2 | trimPrefix "#" }}ff
selection={{ $t.accent | trimPrefix "#" }}ff
selection-text={{ $t.bg | trimPrefix "#" }}ff
selection-match={{ $t.accent2 | trimPrefix "#" }}ff
counter={{ $t.fg_mute | trimPrefix "#" }}ff
border={{ $t.border | trimPrefix "#" }}ff

[border]
width=1
radius=0
