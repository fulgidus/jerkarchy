{{- $t := index .themes .theme -}}
/* nwg-drawer — river palette: cyan/magenta on near-black, square, monospace */
* {
    font-family: "JetBrainsMono Nerd Font", monospace;
}

window {
    background-color: alpha({{ $t.bg }}, 0.94);
    color: {{ $t.fg }};
}

entry {
    background-color: {{ $t.bg }};
    color: {{ $t.fg_bright }};
    border: 1px solid {{ $t.border }};
    border-radius: 0;
    caret-color: {{ $t.accent }};
    padding: 4px 8px;
}
entry:focus {
    border-color: {{ $t.accent }};
    box-shadow: none;
}

button, image {
    background: none;
    border: none;
    border-radius: 0;
    color: {{ $t.fg }};
}
button:hover, button:focus {
    background-color: alpha({{ $t.accent }}, 0.10);
    box-shadow: inset 0 -2px 0 {{ $t.accent }};
}

#category-button {
    margin: 0 6px;
    color: {{ $t.fg_dim }};
}
#category-button:hover, #category-button:checked {
    color: {{ $t.accent }};
}

#pinned-box {
    padding-bottom: 5px;
    border-bottom: 1px solid {{ $t.border }};
}

#files-box {
    padding: 5px;
    border: 1px solid {{ $t.border }};
    border-radius: 0;
}

#math-label {
    font-weight: bold;
    font-size: 16px;
    color: {{ $t.accent2 }};
}
