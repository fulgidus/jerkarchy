{{- $t := index .themes .theme -}}
/* gtklock — the lock screen, styled like the bar and the menus: the
   wallpaper's current frame behind a square card (session-lock passes the
   frame as the background), clock in the accent colour. From the theme. */
* {
  font-family: "JetBrainsMono Nerd Font", monospace;
  border-radius: 0;
  box-shadow: none;
  text-shadow: none;
}
window {
  background-color: {{ $t.bg }};
  background-size: cover;
  background-position: center;
  background-repeat: no-repeat;
}
#window-box {
  background-color: alpha({{ $t.bg }}, 0.92);
  border: 1px solid {{ $t.border }};
  border-top: 2px solid {{ $t.accent }};
  padding: 28px 40px 24px;
}
#clock-label { font-size: 64px; font-weight: bold; color: {{ $t.accent }}; }
#date-label  { font-size: 14px; color: {{ $t.fg_dim }}; margin-bottom: 18px; }
#input-label { font-size: 13px; color: {{ $t.fg_dim }}; }
#input-field {
  background: {{ $t.bg_alt }};
  color: {{ $t.fg_bright }};
  caret-color: {{ $t.accent }};
  border: 1px solid {{ $t.border }};
  padding: 6px 10px;
  min-width: 260px;
}
#input-field:focus { border-color: {{ $t.accent }}; }
#unlock-button {
  background: {{ $t.accent }};
  color: {{ $t.bg }};
  border: none;
  padding: 6px 14px;
  font-weight: bold;
}
#unlock-button:hover { background: {{ $t.accent2 }}; }
#error-label, #warning-label { color: {{ $t.err }}; font-size: 13px; }
/* modules: power buttons, now playing, user */
button {
  background: transparent;
  color: {{ $t.fg }};
  border: 1px solid {{ $t.border }};
  padding: 4px 10px;
}
button:hover { color: {{ $t.bg }}; background: {{ $t.accent }}; border-color: {{ $t.accent }}; }
label { color: {{ $t.fg }}; }

