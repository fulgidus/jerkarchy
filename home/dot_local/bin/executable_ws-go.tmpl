#!/bin/sh
# ws-go N — go to workspace number N with a slide (jerkslide): the screen
# being left slides off left (higher N) or right (lower N) while sway switches
# underneath. Setting slide_ms (0 = off: plain switch). Used by the
# Super+1…9 binds and sway-ws; without grim/jerkslide it just switches.
n=${1:?usage: ws-go N}
ms={{ .slide_ms }}
js="$HOME/.local/bin/jerkslide"
switch() { exec swaymsg -q "workspace number $n"; }

[ "$ms" -gt 0 ] && [ -x "$js" ] && command -v grim >/dev/null || switch
read -r cur out <<EOT
$(swaymsg -t get_workspaces -r | jq -r '.[] | select(.focused) | "\(.num) \(.output)"')
EOT
[ "$cur" = "$n" ] && switch          # sway's back_and_forth etc. stay as-is
[ "$n" -gt "${cur:-0}" ] && dir=left || dir=right

fifo="${XDG_RUNTIME_DIR:-/tmp}/ws-go.$$"
mkfifo -m 600 "$fifo" || switch
grim -o "$out" -t ppm - 2>/dev/null | "$js" "$out" "$dir" "$ms" >"$fifo" 2>/dev/null &
# Switch once the overlay is up (or give up waiting after ~1 s).
read -r _ready <"$fifo"
rm -f "$fifo"
switch
