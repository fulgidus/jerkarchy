#!/bin/sh
# jerkarchy-set — change a jerkarchy setting, re-render the dotfiles, reload
# what's running. Settings live in the [data] section of chezmoi.toml and the
# templates in the repo read them, so this is the one place they change
# (jerkarchy-settings is the menu on top of it).
#
#   jerkarchy-set                 list settings and current values
#   jerkarchy-set get KEY         print one value
#   jerkarchy-set themes          list themes, one per line: name TAB title TAB group
#   jerkarchy-set KEY VALUE       set, apply, reload
#
# Keys: theme, wall_contrast (0.5–4), wall_fps (1–60), wall_speed (0.1–5),
#       wall_points (20–600), kb_layout (us | it,us | …), kb_variant (,intl | …),
#       kb_options (grp:alt_shift_toggle | …). "none" clears kb_variant/kb_options.
#       fx_animation_ms (0–2000; SwayFX only, 0 = off).
#       saver_min, lock_min (idle minutes before screensaver / lock, 0–240, 0 = off).
set -e

CFG="${XDG_CONFIG_HOME:-$HOME/.config}/chezmoi/chezmoi.toml"
KEYS="theme wall_contrast wall_fps wall_speed wall_points kb_layout kb_variant kb_options fx_animation_ms saver_min lock_min"

die() { echo "jerkarchy-set: $*" >&2; [ -t 2 ] || notify-send -a jerkarchy -u critical "jerkarchy-set" "$*" 2>/dev/null || true; exit 1; }

# Effective value: chezmoi.toml [data] over the defaults in .chezmoidata.
get() {
    case " $KEYS " in *" $1 "*) ;; *) die "unknown key '$1' (keys: $KEYS)" ;; esac
    chezmoi execute-template "{{ .$1 }}"
}

themes() {
    chezmoi execute-template '{{ range $k, $v := .themes }}{{ $k }}{{ "\t" }}{{ $v.title }}{{ if and $v.light (not (hasKey $v "group")) }} (light){{ end }}{{ "\t" }}{{ if hasKey $v "group" }}{{ $v.group }}{{ end }}{{ "\n" }}{{ end }}'
}

# Write KEY = VALUE (already formatted for TOML) into [data]: replace the
# existing line, or add it after the section's last line (before blank lines);
# creates [data] if the file has none.
put() {
    tmp="$CFG.tmp.$$"
    awk -v k="$1" -v v="$2" '
        function emit() { if (!done) { print k " = " v; done = 1 } }
        function flush() { printf "%s", blanks; blanks = "" }
        /^[[:space:]]*\[/ {
            if (in_data) emit()
            flush()
            in_data = ($0 ~ /^[[:space:]]*\[data\][[:space:]]*$/); seen = seen || in_data
            print; next
        }
        in_data && /^[[:space:]]*$/ { blanks = blanks $0 "\n"; next }
        in_data && $0 ~ "^[[:space:]]*" k "[[:space:]]*=" { flush(); emit(); next }
        { flush(); print }
        END { if (in_data) emit(); flush(); if (!seen) { print ""; print "[data]"; emit() } }
    ' "$CFG" >"$tmp" && mv "$tmp" "$CFG"
}

is_num() { printf '%s' "$1" | grep -qE '^[0-9]+(\.[0-9]+)?$'; }
in_range() { awk -v x="$1" -v lo="$2" -v hi="$3" 'BEGIN { exit !(x >= lo && x <= hi) }'; }

reload_wall() {
    pkill -x jerkwall || true
    swaymsg -q exec "$HOME/.local/bin/jerkwall"
}

reload_theme() {
    swaymsg -q reload                          # borders (client.* colours)
    pkill -USR2 -x waybar || true              # waybar reloads config + style.css
    makoctl reload 2>/dev/null || true
    # nwg-drawer reads its CSS at start: restart the resident instance.
    if pkill -f '^nwg-drawer -r'; then swaymsg -q exec "$HOME/.local/bin/drawer-daemon sway"; fi
    reload_wall                                # colours come from ~/.config/jerkwall/config
    # wezterm watches its config; fuzzel, swaylock, bar-battery read theirs per run.
}

[ -f "$CFG" ] || die "no $CFG (run install.sh)"

case "${1:-}" in
    "")
        for k in $KEYS; do printf '%-14s %s\n' "$k" "$(get "$k")"; done; exit 0 ;;
    get)
        [ -n "${2:-}" ] || die "usage: jerkarchy-set get KEY"; get "$2"; exit 0 ;;
    themes)
        themes; exit 0 ;;
esac

key=$1; val=${2:-}
[ $# -ge 2 ] || die "usage: jerkarchy-set KEY VALUE"
case "$key" in
    theme)
        themes | cut -f1 | grep -qxF "$val" || die "unknown theme '$val' (see: jerkarchy-set themes)"
        toml="\"$val\"" ;;
    wall_contrast) is_num "$val" && in_range "$val" 0.5 4   || die "wall_contrast: 0.5–4";  toml=$val ;;
    wall_speed)    is_num "$val" && in_range "$val" 0.1 5   || die "wall_speed: 0.1–5";     toml=$val ;;
    wall_fps)      printf '%s' "$val" | grep -qE '^[0-9]+$' && in_range "$val" 1 60   || die "wall_fps: integer 1–60";     toml=$val ;;
    wall_points)   printf '%s' "$val" | grep -qE '^[0-9]+$' && in_range "$val" 20 600 || die "wall_points: integer 20–600"; toml=$val ;;
    kb_layout)
        printf '%s' "$val" | grep -qE '^[a-z]{2,3}(,[a-z]{2,3})*$' || die "kb_layout: xkb layouts like us or it,us"
        toml="\"$val\"" ;;
    kb_variant|kb_options)
        [ "$val" = none ] && val=""
        [ -z "$val" ] || printf '%s' "$val" | grep -qE '^[a-z0-9_:,+-]+$' || die "$key: letters, digits and _ : , + - only"
        toml="\"$val\"" ;;
    saver_min|lock_min) printf '%s' "$val" | grep -qE '^[0-9]+$' && in_range "$val" 0 240 || die "$key: minutes 0–240 (0 = off)"; toml=$val ;;
    fx_animation_ms) printf '%s' "$val" | grep -qE '^[0-9]+$' && in_range "$val" 0 2000 || die "fx_animation_ms: integer 0–2000"; toml=$val ;;
    *) die "unknown key '$key' (keys: $KEYS)" ;;
esac

# Never clobber hand edits: chezmoi status' first column marks files changed
# since chezmoi last wrote them. Check before touching the config, so a
# refusal leaves everything as it was.
edited=$(chezmoi status </dev/null 2>/dev/null | awk 'substr($0, 1, 1) != " " { print $2 }')
[ -z "$edited" ] || die "edited by hand, not overwriting: $(echo $edited) (chezmoi diff / chezmoi re-add)"

put "$key" "$toml"
chezmoi apply --no-tty </dev/null >/dev/null 2>"${XDG_RUNTIME_DIR:-/tmp}/jerkarchy-set.log" ||
    die "chezmoi apply failed (see ${XDG_RUNTIME_DIR:-/tmp}/jerkarchy-set.log; chezmoi diff shows local edits)"

# Reload only inside a running sway session.
if [ -n "${SWAYSOCK:-}" ] && swaymsg -t get_version >/dev/null 2>&1; then
    case "$key" in
        theme) reload_theme ;;
        wall_*) reload_wall ;;
        kb_*|fx_*|saver_min|lock_min) swaymsg -q reload ;;
    esac
fi
echo "$key = $val"
