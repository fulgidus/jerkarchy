#!/bin/sh
# sway-fx — eye candy when the compositor is SwayFX (a sway fork with
# animations; jerkarchy's default is plain sway, which has none). Run by sway
# on start and on every reload (exec_always), so settings apply on reload.
# On plain sway it does nothing: SwayFX-only commands would be config errors.
# Settings: fx (on/off: all SwayFX effects), fx_animation_ms (open/close and
# resize animations; 0 = off).
case "$(sway --version 2>/dev/null)" in
    *[Ss]way[Ff][Xx]*) ;;
    *) exit 0 ;;
esac
ms=$(chezmoi execute-template '{{ .fx_animation_ms }}' 2>/dev/null)
case "$ms" in ''|*[!0-9]*) ms=250 ;; esac
# fx off (Settings › animations): SwayFX runs like plain sway.
[ "$(chezmoi execute-template '{{ .fx }}' 2>/dev/null)" = off ] && ms=0
swaymsg -q "animation_duration_ms $ms"
