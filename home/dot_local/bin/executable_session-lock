#!/bin/sh
# Lock the session with swaylock: wallpaper + always-visible ring (config in
# ~/.config/swaylock/config). waylock (Zig) was tried first but shows only a
# flat colour by design, so a locked screen looked like a dead one.
# -f: fork once the lock is engaged, so swayidle's before-sleep waits for it.
if command -v swaylock >/dev/null; then
    exec swaylock -f
fi
exec waylock -fork-on-lock -ignore-empty-password \
    -init-color 0x1a2a40 -input-color 0x00f0ff -fail-color 0xff2b6d
